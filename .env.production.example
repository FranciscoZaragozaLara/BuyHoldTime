# Copia a .env.production en el VPS y rellena. NUNCA lo subas a git.
DOMAIN=tudominio.com
ACME_EMAIL=tu-correo@ejemplo.com

# Alfanumérica (va dentro de una URL). Genera una: openssl rand -hex 24
POSTGRES_PASSWORD=
# Genera una: openssl rand -hex 32  (la misma que usan los scripts de BackTesting)
SYNC_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=

# Firebase Admin (cuenta de servicio). La clave privada en una línea, con \n literales y entre comillas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase web (se incrustan al compilar el frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FRED_API_KEY=
# Carpeta de BackTesting en el VPS (por defecto ../BackTesting)
BACKTESTING_PATH=../BackTesting
