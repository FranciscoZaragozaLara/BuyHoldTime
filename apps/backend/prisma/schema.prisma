generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ticker {
  id                     String            @id @default(uuid())
  symbol                 String            @unique
  name                   String
  price                  Float
  sector                 String
  buyHoldIndex           Int               @map("buy_hold_index")
  recommendation         String
  pe                     Float
  dy                     Float
  cap                    String
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  avgVolume              Float?            @map("avg_volume")
  bookValue              Float?            @map("book_value")
  changePercent          Float             @map("change_percent")
  dividendRate           Float?            @map("dividend_rate")
  enterpriseValue        Float?            @map("enterprise_value")
  eps                    Float?
  fiftyTwoWeekHigh       Float?            @map("fifty_two_week_high")
  fiftyTwoWeekLow        Float?            @map("fifty_two_week_low")
  forwardPe              Float?            @map("forward_pe")
  pegRatio               Float?            @map("peg_ratio")
  trailingPe             Float?            @map("trailing_pe")
  historicalDividends    Json?             @map("historical_dividends")
  historicalEps          Json?             @map("historical_eps")
  historicalEpsQuarterly Json?             @map("historical_eps_quarterly")
  sectorTerminalPe       Float?            @map("sector_terminal_pe")
  historicalPrices       HistoricalPrice[]

  @@map("tickers")
}

model HistoricalPrice {
  id       String   @id @default(uuid())
  tickerId String   @map("ticker_id")
  date     DateTime @db.Date
  open     Float
  high     Float
  low      Float
  close    Float
  volume   BigInt
  adjClose Float    @map("adj_close")
  ticker   Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([tickerId, date])
  @@map("historical_prices")
}

model Indicator {
  id           String             @id @default(uuid())
  key          String             @unique
  name         String
  currentValue Float              @map("current_value")
  unit         String
  status       String
  description  String
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  history      IndicatorHistory[]

  @@map("indicators")
}

model IndicatorHistory {
  id          String    @id @default(uuid())
  indicatorId String    @map("indicator_id")
  date        DateTime  @db.Date
  value       Float
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, date])
  @@map("indicator_histories")
}

model Subscription {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscriptions")
}

model Stock {
  id          Int        @id @default(autoincrement())
  ticker      String     @unique
  companyName String?    @map("companyName")
  exchange    String?
  isActive    Boolean    @map("isActive")
  revenue     Decimal?   @db.Decimal
  eps         Decimal?   @db.Decimal
  createdAt   DateTime   @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")
  snapshots   Snapshot[]

  @@map("stocks")
}

model Snapshot {
  id               Int      @id @default(autoincrement())
  stockId          Int      @map("stockId")
  scrapeDate       DateTime @map("scrapeDate") @db.Date
  price            Decimal? @db.Decimal
  gfValue          Decimal? @db.Decimal
  gfScore          Int?     @map("gfScore")
  pe               Decimal? @db.Decimal
  pb               Decimal? @db.Decimal
  recommendation   String?
  scores           Json?
  tables           Json?
  analystEstimates Json?    @map("analystEstimates")
  todayChart       Json?    @map("todayChart")
  status           String
  errorMessage     String?  @map("errorMessage")
  createdAt        DateTime @map("createdAt")
  dividendYield    Decimal? @db.Decimal
  earningsYield    Decimal? @db.Decimal
  evToEbitda       Decimal? @db.Decimal
  forwardPe        Decimal? @db.Decimal
  pegRatio         Decimal? @db.Decimal
  psRatio          Decimal? @db.Decimal
  shillerPe        Decimal? @db.Decimal
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, scrapeDate])
  @@index([stockId, scrapeDate])
  @@map("snapshots")
}

enum Role {
  FREE_USER
  PRO_USER
  ADMIN
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  role        Role     @default(FREE_USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model MarginDebt {
  id                    String   @id @default(uuid())
  date                  DateTime @unique @db.Date
  debitBalances         Float    @map("debit_balances")
  freeCreditCash        Float    @map("free_credit_cash")
  freeCreditMargin      Float    @map("free_credit_margin")
  netCreditBalance      Float    @map("net_credit_balance")
  sp500Price            Float?   @map("sp500_price")
  currencyInCirculation Float?   @map("currency_in_circulation") // En millones USD (FRED MBCURRCIR)
  marginCurrencyRatio   Float?   @map("margin_currency_ratio") // Margin Debt / Currency (%)
  marginDebtRatio       Float?   @map("margin_debt_ratio")
  marginDebtYoY         Float?   @map("margin_debt_yoy")
  sp500YoY              Float?   @map("sp500_yoy")
  divergence            Float?
  riskScore             Int?     @map("risk_score")
  riskLevel             String?  @map("risk_level")
  source                String   @default("FINRA")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("margin_debt")
}

// === Fase 6 Backtesting — TQQQ/QQQ ===
model BtMarketData {
  id          String   @id @default(uuid())
  ticker      String
  date        DateTime @db.Date
  open        Float
  high        Float
  low         Float
  close       Float
  adjClose    Float    @map("adj_close")
  volume      BigInt
  source      String   @default("yfinance")
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([ticker, date])
  @@index([ticker, date])
  @@map("bt_market_data")
}

model BtStrategy {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  description  String?
  paramsSchema Json?           @map("params_schema")
  version      String          @default("1.0")
  createdAt    DateTime        @default(now()) @map("created_at")
  runs         BtBacktestRun[]

  @@map("bt_strategies")
}

model BtStartDate {
  id           String   @id @default(uuid())
  startDate    DateTime @unique @map("start_date") @db.Date
  label        String
  descriptor   String?
  category     String?  @map("category")
  isTradingDay Boolean  @default(true) @map("is_trading_day")
  source       String?  @map("source")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("bt_start_dates")
}

model BtBacktestRun {
  id          String             @id @default(uuid())
  strategyId  String             @map("strategy_id")
  strategy    BtStrategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  initialCash Float              @map("initial_cash")
  commission  Float
  paramsUsed  Json               @map("params_used")
  status      String             @default("completed")
  createdAt   DateTime           @default(now()) @map("created_at")
  metrics     BtBacktestMetrics?
  equityCurve BtEquityCurve[]
  trades      BtTrade[]
  allocations BtAllocation[]

  @@unique([strategyId, startDate])
  @@index([strategyId, startDate])
  @@map("bt_backtest_runs")
}

model BtBacktestMetrics {
  id                String        @id @default(uuid())
  runId             String        @unique @map("run_id")
  run               BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  finalValue        Float         @map("final_value")
  totalReturn       Float         @map("total_return")
  cagr              Float
  sharpe            Float?
  maxDrawdown       Float         @map("max_drawdown")
  maxDdLength       Int?          @map("max_dd_length")
  numTrades         Int?          @map("num_trades")
  winRate           Float?        @map("win_rate")
  sqn               Float?
  benchmarkCagrQqq  Float?        @map("benchmark_cagr_qqq")
  benchmarkCagrTqqq Float?        @map("benchmark_cagr_tqqq")

  @@map("bt_backtest_metrics")
}

model BtEquityCurve {
  id             String        @id @default(uuid())
  runId          String        @map("run_id")
  run            BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  portfolioValue Float         @map("portfolio_value")
  drawdown       Float?

  @@unique([runId, date])
  @@index([runId, date])
  @@map("bt_equity_curve")
}

model BtTrade {
  id         String        @id @default(uuid())
  runId      String        @map("run_id")
  run        BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ticker     String
  side       String
  size       Float
  price      Float
  value      Float
  commission Float?
  datetime   DateTime
  targetPct  Float?        @map("target_pct")
  indicators Json?

  @@map("bt_trades")
}

model BtAllocation {
  id             String        @id @default(uuid())
  runId          String        @map("run_id")
  run            BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  tqqqPct        Float         @map("tqqq_pct")
  cashPct        Float         @map("cash_pct")
  tqqqValue      Float         @map("tqqq_value")
  cashValue      Float         @map("cash_value")
  portfolioValue Float         @map("portfolio_value")
  targetPct      Float?        @map("target_pct")
  indicators     Json?

  @@unique([runId, date])
  @@index([runId, date])
  @@map("bt_allocations")
}

// Termómetro BuyHoldTime al cierre: subconjunto disponible por fecha.
// value = numerator/denominator (base 100); coverage = nº indicadores incluidos.
model BtThermoHistory {
  date          DateTime @id @db.Date
  value         Float
  numerator     Float
  denominator   Float
  coverage      Int
  bonus         Float    @default(0)
  bonusLabel    String?  @map("bonus_label")
  liqBonus      Float    @default(0) @map("liq_bonus")
  liqBonusLabel String?  @map("liq_bonus_label")
  oilBonus      Float    @default(0) @map("oil_bonus")
  oilBonusLabel String?  @map("oil_bonus_label")
  // Régimen tendencial del S&P 500 (cierre vs SMA 50/200): UPTREND · PULLBACK · REBOUND · DOWNTREND.
  trendRegime   String?  @map("trend_regime")
  spxSma50      Float?   @map("spx_sma50")
  spxSma200     Float?   @map("spx_sma200")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bt_thermo_history")
}

// CAPE Shiller diario reconstruido (fuente del endpoint shiller-daily).
// Lo llena prisma/sync-shiller-daily.ts desde el CSV de BackTesting y el
// market-sync diario agrega/reescribe las filas recientes.
model BtShillerDaily {
  date         DateTime  @id @db.Date
  pe           Float?
  cape         Float? // CAPE registrado: SPX / E10 del último mes publicado ese día
  capeAdjusted Float?    @map("cape_adjusted") // informativo: SPX / E10 del propio mes (revisable)
  e10          Float? // denominador usado por el registrado (P/CAPE del mes e10Month)
  e10Month     DateTime? @map("e10_month") @db.Date
  capeSma3     Float?    @map("cape_sma3")
  capeSma5     Float?    @map("cape_sma5")
  capeSma10    Float?    @map("cape_sma10")
  capeEma3     Float?    @map("cape_ema3")
  capeEma5     Float?    @map("cape_ema5")
  capeEma10    Float?    @map("cape_ema10")
  mean3y       Float?
  mean5y       Float?
  mean10y      Float?
  mean3yEma    Float?    @map("mean3y_ema")
  mean5yEma    Float?    @map("mean5y_ema")
  mean10yEma   Float?    @map("mean10y_ema")
  std3y        Float?
  std5y        Float?
  std10y       Float?
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("bt_shiller_daily")
}

// BHT Index + precios y retornos forward maduros (1/2/3/5Y) por índice.
// Solo se guardan horizontes con fecha objetivo <= último dato disponible.
model BtBhtForward {
  date      DateTime @id @db.Date
  bhtValue  Float?   @map("bht_value")
  spx       Float?
  ndx       Float?
  tqqq      Float?
  spx1y     Float?   @map("spx_1y")
  spx2y     Float?   @map("spx_2y")
  spx3y     Float?   @map("spx_3y")
  spx5y     Float?   @map("spx_5y")
  ndx1y     Float?   @map("ndx_1y")
  ndx2y     Float?   @map("ndx_2y")
  ndx3y     Float?   @map("ndx_3y")
  ndx5y     Float?   @map("ndx_5y")
  tqqq1y    Float?   @map("tqqq_1y")
  tqqq2y    Float?   @map("tqqq_2y")
  tqqq3y    Float?   @map("tqqq_3y")
  tqqq5y    Float?   @map("tqqq_5y")
  parts     Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bt_bht_forward")
}

// Monitor de frescura (fase 2): una fila por corrida de extracción de cada fuente.
// source = id de la fuente en src/modules/admin/data-freshness.ts.
model DataSourceRun {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     String
  process    String
  startedAt  DateTime @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime @default(now()) @map("finished_at") @db.Timestamptz(6)
  status     String
  rows       Int?
  message    String?

  @@index([source, startedAt(sort: Desc)], map: "data_source_runs_source_started_idx")
  @@map("data_source_runs")
}

// ── Laboratorio Canary & Phoenix (experimental, solo informativo; migración 20261122000000) ──────────────────────

model ExpScoreConfig {
  version  String   @id
  params   Json
  frozenAt DateTime @default(now()) @map("frozen_at") @db.Timestamptz(6)
  notes    String?

  canaryBaskets  ExpCanaryBasket[]
  phoenixCohorts ExpPhoenixCohort[]
  paperPositions ExpPaperPosition[]
  scores         ExpScoreDaily[]

  @@map("exp_score_config")
}

model ExpUniverseMonthly {
  asOf            DateTime @map("as_of") @db.Date
  symbol          String
  marketCap       Float?   @map("market_cap")
  avgVolume       Float?   @map("avg_volume")
  sector          String?
  industry        String?
  optionSpreadPct Float?   @map("option_spread_pct")
  source          String

  @@id([asOf, symbol])
  @@map("exp_universe_monthly")
}

model ExpFundamentalsPit {
  symbol     String
  asOf       DateTime  @map("as_of") @db.Date
  source     String
  filedDate  DateTime? @map("filed_date") @db.Date
  fcfTtm     Float?    @map("fcf_ttm")
  fcfMargin  Float?    @map("fcf_margin")
  psRatio    Float?    @map("ps_ratio")
  forwardPe  Float?    @map("forward_pe")
  roe        Float?
  roic       Float?
  debtEbitda Float?    @map("debt_ebitda")

  @@id([symbol, asOf, source])
  @@map("exp_fundamentals_pit")
}

model ExpCanaryBasket {
  month         DateTime       @db.Date
  symbol        String
  rank          Int
  sector        String?
  extSma50      Float?         @map("ext_sma50")
  fragility     Json?
  isAnchor      Boolean        @default(false) @map("is_anchor")
  configVersion String         @map("config_version")
  config        ExpScoreConfig @relation(fields: [configVersion], references: [version], onDelete: NoAction, onUpdate: NoAction)

  @@id([month, symbol, configVersion])
  @@map("exp_canary_basket")
}

model ExpPhoenixCohort {
  cohortId      String         @map("cohort_id")
  symbol        String
  frozenAt      DateTime       @map("frozen_at") @db.Date
  cohortSize    Int            @map("cohort_size")
  sector        String?
  industry      String?
  phoenixRank   Float?         @map("phoenix_rank")
  components    Json?
  status        String         @default("active")
  purgedAt      DateTime?      @map("purged_at") @db.Date
  purgeReason   String?        @map("purge_reason")
  configVersion String         @map("config_version")
  config        ExpScoreConfig @relation(fields: [configVersion], references: [version], onDelete: NoAction, onUpdate: NoAction)

  @@id([cohortId, symbol, cohortSize])
  @@map("exp_phoenix_cohort")
}

model ExpOptionQuote {
  id             BigInt    @id @default(autoincrement())
  snapshotTs     DateTime  @map("snapshot_ts") @db.Timestamptz(6)
  quoteTime      DateTime? @map("quote_time") @db.Timestamptz(6)
  dataType       String    @map("data_type")
  source         String    @default("yahoo")
  contractSymbol String?   @map("contract_symbol")
  underlying     String
  conId          BigInt?   @map("con_id")
  expiry         DateTime  @db.Date
  strike         Float
  optRight       String    @map("opt_right") @db.Char(1)
  bid            Float?
  ask            Float?
  last           Float?
  volume         BigInt?
  openInterest   BigInt?   @map("open_interest")
  ivIbkr         Float?    @map("iv_ibkr")
  ivCalc         Float?    @map("iv_calc")
  delta          Float?
  gamma          Float?
  vega           Float?
  theta          Float?
  undPrice       Float?    @map("und_price")

  @@index([underlying, snapshotTs(sort: Desc)], map: "exp_option_quotes_und_ts")
  @@index([underlying, expiry, strike, optRight, snapshotTs], map: "exp_option_quotes_contract")
  @@map("exp_option_quotes")
}

model ExpPaperPosition {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategy      String
  tranche       String?
  episodeId     String?        @map("episode_id")
  underlying    String
  legs          Json
  openedAt      DateTime       @map("opened_at") @db.Date
  entryPrice    Float          @map("entry_price")
  entryPriceMid Float?         @map("entry_price_mid")
  status        String         @default("open")
  closedAt      DateTime?      @map("closed_at") @db.Date
  exitPrice     Float?         @map("exit_price")
  exitPriceMid  Float?         @map("exit_price_mid")
  exitReason    String?        @map("exit_reason")
  configVersion String         @map("config_version")
  config        ExpScoreConfig @relation(fields: [configVersion], references: [version], onDelete: NoAction, onUpdate: NoAction)
  marks         ExpPaperMark[]

  @@map("exp_paper_positions")
}

model ExpPaperMark {
  positionId       String           @map("position_id") @db.Uuid
  date             DateTime         @db.Date
  markMid          Float?           @map("mark_mid")
  markConservative Float?           @map("mark_conservative")
  undPrice         Float?           @map("und_price")
  iv               Float?
  delta            Float?
  roiPct           Float?           @map("roi_pct")
  position         ExpPaperPosition @relation(fields: [positionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([positionId, date])
  @@map("exp_paper_marks")
}

model ExpScoreDaily {
  date          DateTime       @db.Date
  scoreKey      String         @map("score_key")
  configVersion String         @map("config_version")
  value         Float
  state         String?
  components    Json?
  computedAt    DateTime       @default(now()) @map("computed_at") @db.Timestamptz(6)
  isBackfill    Boolean        @default(false) @map("is_backfill")
  config        ExpScoreConfig @relation(fields: [configVersion], references: [version], onDelete: NoAction, onUpdate: NoAction)

  @@id([date, scoreKey, configVersion])
  @@map("exp_scores_daily")
}

model ExpBtEvent {
  episodeId    String    @id @map("episode_id")
  peakDate     DateTime  @map("peak_date") @db.Date
  troughDate   DateTime? @map("trough_date") @db.Date
  recoveryDate DateTime? @map("recovery_date") @db.Date
  depth        Float?
  metrics      Json?

  @@map("exp_bt_events")
}
