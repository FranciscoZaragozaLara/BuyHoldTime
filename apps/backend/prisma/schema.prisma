generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ticker {
  id                     String            @id @default(uuid())
  symbol                 String            @unique
  name                   String
  price                  Float
  sector                 String
  buyHoldIndex           Int               @map("buy_hold_index")
  recommendation         String
  pe                     Float
  dy                     Float
  cap                    String
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  avgVolume              Float?            @map("avg_volume")
  bookValue              Float?            @map("book_value")
  changePercent          Float             @map("change_percent")
  dividendRate           Float?            @map("dividend_rate")
  enterpriseValue        Float?            @map("enterprise_value")
  eps                    Float?
  fiftyTwoWeekHigh       Float?            @map("fifty_two_week_high")
  fiftyTwoWeekLow        Float?            @map("fifty_two_week_low")
  forwardPe              Float?            @map("forward_pe")
  pegRatio               Float?            @map("peg_ratio")
  trailingPe             Float?            @map("trailing_pe")
  historicalDividends    Json?             @map("historical_dividends")
  historicalEps          Json?             @map("historical_eps")
  historicalEpsQuarterly Json?             @map("historical_eps_quarterly")
  sectorTerminalPe       Float?            @map("sector_terminal_pe")
  historicalPrices       HistoricalPrice[]

  @@map("tickers")
}

model HistoricalPrice {
  id       String   @id @default(uuid())
  tickerId String   @map("ticker_id")
  date     DateTime @db.Date
  open     Float
  high     Float
  low      Float
  close    Float
  volume   BigInt
  adjClose Float    @map("adj_close")
  ticker   Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([tickerId, date])
  @@map("historical_prices")
}

model Indicator {
  id           String             @id @default(uuid())
  key          String             @unique
  name         String
  currentValue Float              @map("current_value")
  unit         String
  status       String
  description  String
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  history      IndicatorHistory[]

  @@map("indicators")
}

model IndicatorHistory {
  id          String    @id @default(uuid())
  indicatorId String    @map("indicator_id")
  date        DateTime  @db.Date
  value       Float
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, date])
  @@map("indicator_histories")
}

model Subscription {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscriptions")
}

model Stock {
  id          Int        @id @default(autoincrement())
  ticker      String
  companyName String?    @map("companyName")
  exchange    String?
  isActive    Boolean    @map("isActive")
  revenue     Decimal?   @db.Decimal
  eps         Decimal?   @db.Decimal
  createdAt   DateTime   @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")
  snapshots   Snapshot[]

  @@map("stocks")
}

model Snapshot {
  id               Int      @id @default(autoincrement())
  stockId          Int      @map("stockId")
  scrapeDate       DateTime @map("scrapeDate") @db.Date
  price            Decimal? @db.Decimal
  gfValue          Decimal? @db.Decimal
  gfScore          Int?     @map("gfScore")
  pe               Decimal? @db.Decimal
  pb               Decimal? @db.Decimal
  recommendation   String?
  scores           Json?
  tables           Json?
  analystEstimates Json?    @map("analystEstimates")
  todayChart       Json?    @map("todayChart")
  status           String
  errorMessage     String?  @map("errorMessage")
  createdAt        DateTime @map("createdAt")
  dividendYield    Decimal? @db.Decimal
  earningsYield    Decimal? @db.Decimal
  evToEbitda       Decimal? @db.Decimal
  forwardPe        Decimal? @db.Decimal
  pegRatio         Decimal? @db.Decimal
  psRatio          Decimal? @db.Decimal
  shillerPe        Decimal? @db.Decimal
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("snapshots")
}

enum Role {
  FREE_USER
  PRO_USER
  ADMIN
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  role        Role     @default(FREE_USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model MarginDebt {
  id                    String   @id @default(uuid())
  date                  DateTime @unique @db.Date
  debitBalances         Float    @map("debit_balances")
  freeCreditCash        Float    @map("free_credit_cash")
  freeCreditMargin      Float    @map("free_credit_margin")
  netCreditBalance      Float    @map("net_credit_balance")
  sp500Price            Float?   @map("sp500_price")
  currencyInCirculation Float?   @map("currency_in_circulation") // En millones USD (FRED MBCURRCIR)
  marginCurrencyRatio   Float?   @map("margin_currency_ratio")    // Margin Debt / Currency (%)
  marginDebtRatio       Float?   @map("margin_debt_ratio")
  marginDebtYoY         Float?   @map("margin_debt_yoy")
  sp500YoY              Float?   @map("sp500_yoy")
  divergence            Float?
  riskScore             Int?     @map("risk_score")
  riskLevel             String?  @map("risk_level")
  source                String   @default("FINRA")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("margin_debt")
}



// === Fase 6 Backtesting — TQQQ/QQQ ===
model BtMarketData {
  id          String   @id @default(uuid())
  ticker      String
  date        DateTime @db.Date
  open        Float
  high        Float
  low         Float
  close       Float
  adjClose    Float    @map("adj_close")
  volume      BigInt
  source      String   @default("yfinance")
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([ticker, date])
  @@index([ticker, date])
  @@map("bt_market_data")
}

model BtStrategy {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  description  String?
  paramsSchema Json?           @map("params_schema")
  version      String          @default("1.0")
  createdAt    DateTime        @default(now()) @map("created_at")
  runs         BtBacktestRun[]

  @@map("bt_strategies")
}

model BtStartDate {
  id           String   @id @default(uuid())
  startDate    DateTime @unique @db.Date @map("start_date")
  label        String
  descriptor   String?
  category     String?  @map("category")
  isTradingDay Boolean  @default(true) @map("is_trading_day")
  source       String?  @map("source")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("bt_start_dates")
}

model BtBacktestRun {
  id          String             @id @default(uuid())
  strategyId  String             @map("strategy_id")
  strategy    BtStrategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  initialCash Float              @map("initial_cash")
  commission  Float
  paramsUsed  Json               @map("params_used")
  status      String             @default("completed")
  createdAt   DateTime           @default(now()) @map("created_at")
  metrics     BtBacktestMetrics?
  equityCurve BtEquityCurve[]
  trades      BtTrade[]
  allocations BtAllocation[]

  @@unique([strategyId, startDate])
  @@index([strategyId, startDate])
  @@map("bt_backtest_runs")
}

model BtBacktestMetrics {
  id                String        @id @default(uuid())
  runId             String        @unique @map("run_id")
  run               BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  finalValue        Float         @map("final_value")
  totalReturn       Float         @map("total_return")
  cagr              Float
  sharpe            Float?
  maxDrawdown       Float         @map("max_drawdown")
  maxDdLength       Int?          @map("max_dd_length")
  numTrades         Int?          @map("num_trades")
  winRate           Float?        @map("win_rate")
  sqn               Float?
  benchmarkCagrQqq  Float?        @map("benchmark_cagr_qqq")
  benchmarkCagrTqqq Float?        @map("benchmark_cagr_tqqq")

  @@map("bt_backtest_metrics")
}

model BtEquityCurve {
  id             String        @id @default(uuid())
  runId          String        @map("run_id")
  run            BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  portfolioValue Float         @map("portfolio_value")
  drawdown       Float?

  @@unique([runId, date])
  @@index([runId, date])
  @@map("bt_equity_curve")
}

model BtTrade {
  id         String        @id @default(uuid())
  runId      String        @map("run_id")
  run        BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ticker     String
  side       String
  size       Float
  price      Float
  value      Float
  commission Float?
  datetime   DateTime
  targetPct  Float?        @map("target_pct")
  indicators Json?

  @@map("bt_trades")
}

model BtAllocation {
  id             String        @id @default(uuid())
  runId          String        @map("run_id")
  run            BtBacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  tqqqPct        Float         @map("tqqq_pct")
  cashPct        Float         @map("cash_pct")
  tqqqValue      Float         @map("tqqq_value")
  cashValue      Float         @map("cash_value")
  portfolioValue Float         @map("portfolio_value")
  targetPct      Float?        @map("target_pct")
  indicators     Json?

  @@unique([runId, date])
  @@index([runId, date])
  @@map("bt_allocations")
}
